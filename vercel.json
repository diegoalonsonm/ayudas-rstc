{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "URL_SERVICIO_BACKEND"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/main.ts"
        }
    },
    "rewrites": [
        {
            "source": "/api/backend(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}