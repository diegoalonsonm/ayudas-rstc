# Copie este archivo a /opt/ayudas-rstc/.env en el servidor.
# No lo suba a git ni lo ponga como secreto de GitHub: vive solo en el host.

# Dominio público (Let’s Encrypt) o hostname MagicDNS de Tailscale.
PUBLIC_HOST=dev.tudominio.cr
ACME_EMAIL=tu@correo

# Comunicación interna entre contenedores. No cambie esto salvo que
# renombre el servicio backend en docker-compose.yml.
URL_API_BACKEND=http://backend:3000/api/v1

# Kong de Supabase self-hosted en el host (no use 127.0.0.1: desde el
# contenedor eso apunta al propio backend, no a Supabase).
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATOS_SENSIBLES_CLAVE=
